@AppointmentService.Api_HostAddress = http://localhost:5263

GET {{AppointmentService.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

# Use these IDs consistently across requests.
@tenantId = 11111111-1111-1111-1111-111111111111
@userId = 22222222-2222-2222-2222-222222222222
@serviceId = 33333333-3333-3333-3333-333333333333

# Step 1: Book appointment (copy the returned appointmentId into @appointmentId below)
POST {{AppointmentService.Api_HostAddress}}/appointments
Content-Type: application/json

{
  "tenantId": "{{tenantId}}",
  "userId": "{{userId}}",
  "serviceId": "{{serviceId}}",
  "slotStart": "2026-02-22T10:00:00Z",
  "slotEnd": "2026-02-22T10:15:00Z",
  "priorityLevel": 1,
  "customerName": "Test Customer",
  "customerPhone": "9999999999"
}

###

@appointmentId = 00000000-0000-0000-0000-000000000000

# Step 2: Get appointment by id
GET {{AppointmentService.Api_HostAddress}}/appointments/{{appointmentId}}
Accept: application/json

###

# Step 3: Today appointments (scheduled + walk-ins)
GET {{AppointmentService.Api_HostAddress}}/appointments/today?tenantId={{tenantId}}&serviceId={{serviceId}}&date=2026-02-22
Accept: application/json

###

# Step 4: Check in appointment
POST {{AppointmentService.Api_HostAddress}}/appointments/{{appointmentId}}/check-in
Accept: application/json

###

# Step 5: Reschedule a BOOKED appointment (use a different booked appointment id if already checked-in)
PATCH {{AppointmentService.Api_HostAddress}}/appointments/{{appointmentId}}
Content-Type: application/json

{
  "newSlotStart": "2026-02-22T11:00:00Z",
  "newSlotEnd": "2026-02-22T11:20:00Z"
}

###

# Step 6: Cancel a BOOKED appointment (use a different booked appointment id if already checked-in)
POST {{AppointmentService.Api_HostAddress}}/appointments/{{appointmentId}}/cancel
Content-Type: application/json

{
  "reason": "Customer requested cancellation"
}

###

# Create walk-in appointment (immediately appears in /appointments/today)
POST {{AppointmentService.Api_HostAddress}}/appointments/walk-in
Content-Type: application/json

{
  "tenantId": "{{tenantId}}",
  "userId": "{{userId}}",
  "serviceId": "{{serviceId}}",
  "priorityLevel": 0,
  "customerName": "Walk In Customer"
}

###

# DB health (will be "not-configured" when running in-memory mode)
GET {{AppointmentService.Api_HostAddress}}/health/db
Accept: application/json

###
